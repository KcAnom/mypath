MYPATH_API_PORT=8787
MYPATH_APP_ORIGIN=http://127.0.0.1:8787
MYPATH_DATA_DIR=./data
MYPATH_CHANNEL=local
# Phase 3 defaults to the offline deterministic provider. Use "ollama" for a
# configured local Ollama instance; remote-compatible credentials are read only
# from the environment variable named by provider config (never from SQLite).
MYPATH_PROVIDER=fixture
MYPATH_JOB_CONCURRENCY=3
MYPATH_PROVIDER_TIMEOUT_MS=90000
# MYPATH_OPENAI_API_KEY=set-in-your-shell-or-desktop-environment
