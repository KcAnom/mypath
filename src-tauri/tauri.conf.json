{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyPath",
  "version": "0.1.0",
  "identifier": "local.mypath.desktop",
  "build": {
    "frontendDist": "../.runtime/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyPath",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../.runtime/mypath/": "resources/mypath/"
    }
  }
}
