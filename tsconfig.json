{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["server/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["dist", "src-tauri/resources", "src-tauri/target", "macos/.build"]
}
